      ".indexOn": [
        "t"
      ],
      "$m": {
        ".write": "auth != null && !data.exists() && newData.child('by').val() === auth.uid",
        ".validate": "newData.child('d').child('t').isString() && newData.child('d').child('t').val().length <= 200"
      }
