        ".indexOn": [
          "ts"
        ],
        "$id": {
          ".write": "(auth != null && ((!data.exists() && newData.child('by').val() === auth.uid) || (data.exists() && data.child('by').val() === auth.uid))) || (auth != null && root.child('members').child(auth.uid).child('admin').val() === 'happy_life' && !newData.exists())"
        }
      }
    },
